# Optional but recommended: Grok writes the human-readable integrity verdict.
# If omitted, VouchGuard falls back to a deterministic report from the same graph metrics.
XAI_API_KEY=

# Default Grok model for verdict/explanation generation.
XAI_MODEL=grok-4.5-latest

# Optional. Reserved for future deep X-account checks; NOT required by the normal Commons audit.
X_BEARER_TOKEN=

# Optional but strongly recommended in production for durable public audit pages.
# Vercel creates this automatically when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Cached audits are reused for this many seconds unless refresh=true is requested.
SCAN_CACHE_TTL_SECONDS=21600

# Maximum audit requests accepted per minute by a single server instance.
SCAN_RATE_LIMIT_PER_MINUTE=12

# Use deterministic synthetic Commons graphs instead of calling Commons/xAI.
VOUCHGUARD_DEMO_MODE=false

# Public origin used for share links. Vercel URL is detected automatically when omitted.
NEXT_PUBLIC_APP_URL=
