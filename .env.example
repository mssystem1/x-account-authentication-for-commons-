# Required for live account analysis.
XAI_API_KEY=

# Requested default. Override without code changes when xAI releases a newer model.
XAI_MODEL=grok-4.5-latest

# Optional but strongly recommended in production for durable public result pages.
# Vercel creates this automatically when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Cached scans are reused for this many seconds unless refresh=true is requested.
SCAN_CACHE_TTL_SECONDS=21600

# Maximum scan requests accepted per minute by a single server instance.
SCAN_RATE_LIMIT_PER_MINUTE=12

# Use deterministic simulated results instead of calling xAI. Never enable for production.
VOUCHGUARD_DEMO_MODE=false

# Public origin used for share links. Vercel URL is detected automatically when omitted.
NEXT_PUBLIC_APP_URL=
